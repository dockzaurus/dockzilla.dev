---
import type { ProjectStatus } from '@/data/landing';

interface Props {
	status: ProjectStatus;
	label: string;
	class?: string;
}

const { status, label, class: className } = Astro.props;

/*
 * `*-strong` rather than the plain status colour: the label sits on a 15–20%
 * tint of its own hue, where `text-success` measures 2.6:1 in the light theme
 * and `text-warning-foreground` — never overridden for dark — measures 1.4:1
 * against the dark card. Both are AA at these tokens.
 */
const toneMap: Record<ProjectStatus, string> = {
	running: 'bg-success/15 text-success-strong border-success/40',
	building: 'bg-warning/20 text-warning-strong border-warning/50',
	degraded: 'bg-warning/20 text-warning-strong border-warning/50',
};

const pulseClass = status === 'running' ? 'pulse-dot' : status === 'building' ? 'animate-pulse' : '';
---

<span
	class:list={[
		'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs font-medium',
		toneMap[status],
		className,
	]}
>
	<span class:list={['size-1.5 rounded-full bg-current', pulseClass]}></span>
	{label}
</span>
