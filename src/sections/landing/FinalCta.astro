---
import { Icon } from 'astro-icon/components';

import { resolveLocale, useTranslations } from '@/i18n';
import { SITE } from '@/data/site';
import Button from '@/components/ui/Button.astro';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const t = useTranslations(locale);
---

<section id="cta" class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
	<div data-reveal class="surface-brut hero-glow relative overflow-hidden p-8 text-center sm:p-14">
		<h2 class="font-display text-3xl font-bold sm:text-4xl">
			{t.landing.ctaTitle}
		</h2>
		<p class="mx-auto mt-3 max-w-lg text-muted-foreground">
			{t.landing.ctaBody}
		</p>
		<Button href={SITE.app} size="lg" class="mt-7" data-track="cta_clicked" data-track-location="final_cta">
			{t.common.getStarted}
			<Icon name="lucide:arrow-right" />
		</Button>
	</div>
</section>
