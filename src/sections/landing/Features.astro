---
import { Icon } from 'astro-icon/components';

import { resolveLocale, useTranslations } from '@/i18n';
import { FEATURE_IDS, FEATURE_ICONS } from '@/data/landing';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const t = useTranslations(locale);
---

<section id="features" class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
	<h2 data-reveal class="max-w-2xl font-display text-3xl font-bold sm:text-4xl">
		{t.landing.featuresTitle}
	</h2>
	<div data-reveal-group class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
		{
			FEATURE_IDS.map((id) => (
				<article data-reveal class="surface-brut lift h-full p-6">
					<span class="grid size-11 place-items-center rounded-lg border-2 border-border-strong bg-primary/25">
						<Icon name={FEATURE_ICONS[id]} class="size-5" />
					</span>
					<h3 class="mt-4 font-display text-lg font-bold">{t.landing.features[id].title}</h3>
					<p class="mt-2 text-sm text-muted-foreground">{t.landing.features[id].body}</p>
				</article>
			))
		}
	</div>
</section>
