---
/**
 * Every `<head>` tag that is derived rather than authored: canonical URL,
 * Open Graph, Twitter cards, `hreflang` alternates and JSON-LD.
 *
 * Pages pass only what they actually know (title, description); everything
 * locale- or route-dependent is computed here so no page can forget it.
 */
import { SITE } from '@/data/site';
import { getAlternateLinks, LOCALE_META, type Locale } from '@/i18n';

interface Props {
	locale: Locale;
	title: string;
	description: string;
	/** Path to an OG image in `public/`, or an absolute URL. */
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const { locale, title, description, image = '/og-default.png', type = 'website', noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const imageUrl = new URL(image, Astro.site ?? SITE.url);
const alternates = getAlternateLinks(Astro.url, Astro.site ?? new URL(SITE.url), locale);
const defaultAlternate = alternates.find((link) => link.locale === 'en');

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: SITE.name,
	description,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Linux',
	url: SITE.url,
	codeRepository: SITE.repo,
	license: 'https://www.apache.org/licenses/LICENSE-2.0',
	offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
{defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{
	alternates
		.filter((link) => !link.isCurrent)
		.map((link) => <meta property="og:locale:alternate" content={LOCALE_META[link.locale].ogLocale} />)
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
