---
import Logo from '@/components/brand/Logo.astro';
import LocaleSwitcher from '@/components/kit/LocaleSwitcher.astro';
import ThemeToggle from '@/components/kit/ThemeToggle.astro';
import Button from '@/components/ui/Button.astro';
import { SITE } from '@/data/site';
import { localizePath, resolveLocale, useTranslations } from '@/i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const t = useTranslations(locale);
const home = localizePath('/', locale);
const isHome = Astro.url.pathname === home;

/** `goto` names the jump these links answer to — see `src/scripts/vim.ts`. */
const links = [
	{ href: `${home}#features`, label: t.nav.features, goto: 'features' },
	{ href: SITE.docs, label: t.nav.docs, goto: 'docs', external: true },
];
---

<header class="sticky top-0 z-40 border-b-2 border-border-strong bg-background/85 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-3">
		<a
			href={home}
			data-goto="home"
			aria-label={`${SITE.name} — ${t.common.home}`}
			aria-current={isHome ? 'page' : undefined}
			class="rounded-md"
		>
			<Logo />
		</a>

		<nav
			aria-label={t.common.mainNav}
			class="ml-6 hidden items-center gap-5 text-sm font-medium text-muted-foreground md:flex"
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						data-goto={link.goto}
						rel={link.external ? 'noopener' : undefined}
						class="rounded-sm transition-colors hover:text-foreground"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="ml-auto flex items-center gap-2">
			<LocaleSwitcher />
			<ThemeToggle />
			<Button href={SITE.app} size="sm" data-track="cta_clicked" data-track-location="header">
				{t.common.signIn}
			</Button>
		</div>
	</div>
</header>
