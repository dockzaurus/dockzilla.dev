---
/**
 * Plain links to the current route in each locale — no JavaScript, and
 * crawlable, which a scripted dropdown would not be.
 */
import { getAlternateLinks, resolveLocale, useTranslations } from '@/i18n';

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const t = useTranslations(locale);
const links = getAlternateLinks(Astro.url, undefined, locale);
---

<nav aria-label={t.common.language} class="flex items-center rounded-md border-2 border-border-strong bg-background">
	{
		links.map((link) => (
			<a
				href={link.href}
				hreflang={link.hreflang}
				lang={link.hreflang}
				aria-current={link.isCurrent ? 'true' : undefined}
				title={link.nativeName}
				class:list={[
					'px-2 py-1 text-xs font-semibold transition-colors first:rounded-l-[3px] last:rounded-r-[3px]',
					link.isCurrent
						? 'bg-primary text-primary-foreground'
						: 'text-muted-foreground hover:bg-accent hover:text-accent-foreground',
				]}
			>
				{link.short}
			</a>
		))
	}
</nav>
