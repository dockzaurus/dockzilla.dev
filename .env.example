# Copy to `.env` and fill in to turn analytics on.
# With PUBLIC_POSTHOG_KEY unset, analytics is a no-op and posthog-js is never
# downloaded by the browser — see src/lib/analytics.ts.

# Project API key from PostHog → Settings → Project.
# This key is public by design; it is embedded in the client bundle.
PUBLIC_POSTHOG_KEY=

# EU cloud by default. Use https://us.i.posthog.com for US cloud,
# or your own origin if you self-host PostHog.
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
