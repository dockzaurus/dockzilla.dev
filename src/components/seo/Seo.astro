---
/**
 * Every `<head>` tag that is derived rather than authored: canonical URL,
 * robots directives, Open Graph, Twitter cards, `hreflang` alternates and
 * JSON-LD.
 *
 * Pages pass only what they actually know (title, description); everything
 * locale- or route-dependent is computed here so no page can forget it.
 */
import { SITE } from '@/data/site';
import { getAlternateLinks, LOCALE_META, useTranslations, type Locale } from '@/i18n';

/**
 * Site-wide social cards, one per locale, generated by `scripts/generate-og.mjs`.
 * Keep the declared size in sync with that script.
 */
const defaultImageFor = (locale: Locale) => `/og/${locale}.png`;
const DEFAULT_OG_SIZE = { width: '1200', height: '630' };

interface Props {
	locale: Locale;
	title: string;
	description: string;
	/** Shorter variant for social cards, where descriptions are clipped early. */
	ogDescription?: string;
	/** Path to an OG image in `public/`, or an absolute URL. Defaults to the locale's card. */
	image?: string;
	/** Describes `image`; defaults to the locale's description of the site-wide card. */
	imageAlt?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const {
	locale,
	title,
	description,
	ogDescription = description,
	image: imageProp,
	imageAlt,
	type = 'website',
	noindex = false,
} = Astro.props;

// The default depends on `locale`, so it is resolved after destructuring.
const defaultImage = defaultImageFor(locale);
const image = imageProp ?? defaultImage;

const t = useTranslations(locale);
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site);
const imageUrl = new URL(image, site);
const alt = imageAlt ?? t.meta.imageAlt;
/** Only the cards we ship have known dimensions; a page-supplied image may be any size. */
const imageSize = image === defaultImage ? DEFAULT_OG_SIZE : undefined;
const alternates = getAlternateLinks(Astro.url, site, locale);
const defaultAlternate = alternates.find((link) => link.locale === 'en');

/**
 * Crawlers get the widest snippet and thumbnail we can ask for — the default
 * caps both, which costs us the large image in Discover and rich results.
 */
const robots = noindex
	? 'noindex, nofollow'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

/**
 * One `@graph` rather than three loose blocks, so the organisation, the site
 * and the product are linked by `@id` instead of being re-stated per page.
 */
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${SITE.url}/#organization`,
			name: SITE.name,
			url: SITE.url,
			logo: new URL('/logo-512.png', site).href,
			foundingDate: String(SITE.foundedYear),
			sameAs: [SITE.repo],
		},
		{
			'@type': 'WebSite',
			'@id': `${SITE.url}/#website`,
			name: SITE.name,
			url: SITE.url,
			description,
			inLanguage: LOCALE_META[locale].htmlLang,
			publisher: { '@id': `${SITE.url}/#organization` },
		},
		{
			'@type': 'SoftwareApplication',
			'@id': `${SITE.url}/#software`,
			name: SITE.name,
			description,
			applicationCategory: 'DeveloperApplication',
			applicationSubCategory: 'Self-hosted PaaS',
			operatingSystem: 'Linux',
			url: SITE.url,
			image: imageUrl.href,
			inLanguage: LOCALE_META[locale].htmlLang,
			codeRepository: SITE.repo,
			softwareHelp: SITE.docs,
			license: 'https://www.apache.org/licenses/LICENSE-2.0',
			isAccessibleForFree: true,
			publisher: { '@id': `${SITE.url}/#organization` },
			featureList: Object.values(t.landing.features).map((feature) => feature.title),
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
		},
		{
			'@type': 'WebPage',
			'@id': `${canonical.href}#webpage`,
			url: canonical.href,
			name: title,
			description,
			inLanguage: LOCALE_META[locale].htmlLang,
			isPartOf: { '@id': `${SITE.url}/#website` },
			about: { '@id': `${SITE.url}/#software` },
			primaryImageOfPage: imageUrl.href,
		},
	],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
<meta name="robots" content={robots} />

{alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
{defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={imageUrl.href} />
{
	imageSize && (
		<>
			<meta property="og:image:width" content={imageSize.width} />
			<meta property="og:image:height" content={imageSize.height} />
		</>
	)
}
<meta property="og:image:alt" content={alt} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{
	alternates
		.filter((link) => !link.isCurrent)
		.map((link) => <meta property="og:locale:alternate" content={LOCALE_META[link.locale].ogLocale} />)
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={ogDescription} />
<meta name="twitter:image" content={imageUrl.href} />
<meta name="twitter:image:alt" content={alt} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
