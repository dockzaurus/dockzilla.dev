---
/**
 * The document shell shared by every page (landing today, blog next).
 *
 * Owns three things nothing else should duplicate: the `<head>`, the two
 * behaviours that need JavaScript (theme persistence and scroll reveals), and
 * the header/footer chrome. Pages supply content and metadata only.
 */
import { Font } from 'astro:assets';

import Seo from '@/components/seo/Seo.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import KeymapHelp from '@/components/kit/KeymapHelp.astro';
import { LOCALE_META, resolveLocale, useTranslations } from '@/i18n';
import '@/styles/global.css';

interface Props {
	title: string;
	description: string;
	/** Shorter variant for social cards; falls back to `description`. */
	ogDescription?: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	/** Set to false on pages that provide their own chrome. */
	chrome?: boolean;
}

const { title, description, ogDescription, image, imageAlt, type, noindex, chrome = true } = Astro.props;

const locale = resolveLocale(Astro.currentLocale, Astro.url);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		{/* sRGB equivalents of the `--background` tokens in `global.css`. */}
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f9ee" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a140e" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<Font cssVariable="--font-space-grotesk" preload />
		<Font cssVariable="--font-dm-sans" preload />
		<Font cssVariable="--font-jetbrains-mono" />

		<Seo
			locale={locale}
			title={title}
			description={description}
			ogDescription={ogDescription}
			image={image}
			imageAlt={imageAlt}
			type={type}
			noindex={noindex}
		/>

		{/* Applied before first paint so the theme never flashes. */}
		<script is:inline>
			(() => {
				const KEY = 'dockzilla.theme';
				let stored = null;
				try {
					stored = localStorage.getItem(KEY);
				} catch {
					/* storage blocked — fall back to the system preference */
				}
				const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
			})();
		</script>

		{/*
		  Reveals are JS-driven; without it, show everything in its final state.

		  Every selector is qualified with `:root` to outrank the starting states
		  in `global.css`. Astro emits that stylesheet *after* this block, so at
		  equal specificity the hidden state would win and the page would render
		  blank — the one failure this block exists to prevent.
		*/}
		<noscript>
			<style>
				:root [data-reveal] {
					opacity: 1;
				}
				:root [data-usage-fill] {
					width: var(--usage-value);
				}
				:root [data-chart-grid] {
					opacity: 1;
				}
				:root [data-chart-wipe] {
					transform: none;
				}
				:root [data-chart-dot] {
					opacity: 1;
					offset-distance: 100%;
				}
			</style>
		</noscript>

		<slot name="head" />
	</head>

	<body class="min-h-screen bg-background text-foreground antialiased">
		<a
			href="#main"
			class="sr-only rounded-md border-2 border-border-strong bg-card px-4 py-2 font-medium focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50"
		>
			{t.common.skipToContent}
		</a>

		{chrome && <Header />}

		{/*
		 * `tabindex="-1"` is what makes the skip link work in Safari and WebKit,
		 * which scroll to the target but leave focus behind without it. The
		 * outline is suppressed because focus arrives programmatically here — the
		 * user did not Tab to the `<main>` element itself.
		 */}
		<main id="main" tabindex="-1" class="focus:outline-none">
			<slot />
		</main>

		{chrome && <Footer />}

		{/*
		 * One polite live region for the whole document — see `scripts/announce.ts`.
		 * It must be in the DOM from first paint: a region inserted at the moment
		 * it has something to say is not yet observed, and the message is lost.
		 */}
		<div data-live-region role="status" aria-live="polite" aria-atomic="true" class="sr-only"></div>

		<KeymapHelp />

		<script>
			import '@/scripts/reveal';
			import '@/scripts/analytics';
			import '@/scripts/vim';
		</script>
	</body>
</html>
